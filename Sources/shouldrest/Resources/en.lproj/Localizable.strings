"about.eyeGateBody" = "Opaque screen coverage keeps 20-second eye rests hard to ignore.";
"about.bodyBreakTitle" = "Configurable Body Breaks";
"about.bodyBreakBody" = "Longer breaks keep postpones, display rules, images, and manual finish.";
"about.compatibilityTitle" = "Stretchly-compatible where it helps";

"about.title" = "About ShouldRest";
"about.body" = "ShouldRest %@\n\nShouldRest is a Mac-first rest reminder built around short, frequent, hard-to-ignore Eye Gates and configurable Body Breaks.\n\nIt keeps Stretchly-compatible scheduling, automation, update, debug, and preference capabilities where they support the product goal, while intentionally replacing weak 20-second skip/postpone behavior with stricter eye-rest enforcement.";
"about.version" = "Version %@";
"about.tagline" = "Mac-first rest reminders built around strict eye rests and configurable movement breaks.";
